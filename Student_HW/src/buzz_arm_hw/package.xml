<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>buzz_arm_hw</name>
  <version>0.1.0</version>
  <description>Homework tools: pick-and-place sequencer, simulation preflight, block reset, Cartesian path check.</description>
  <maintainer email="csb1@iastate.edu">Chris Santillan</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>buzz_arm_planning_lab</depend>
  <depend>moveit_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <exec_depend>buzz_arm_sim</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
